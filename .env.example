# Copy to .env (PowerShell:  Copy-Item .env.example .env) and change the passwords.
# Passwords are embedded in a postgres:// URL for pg_tileserv / pg_featureserv,
# so use letters, digits, '-' and '_' only (no @ : / ? # % characters).

# --- PostgreSQL / PostGIS / pgRouting ---------------------------------------
POSTGRES_DB=kochi_health
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_db_pass_2026
# Host port for psql / QGIS / DBeaver and the analysis + PMTiles scripts
# (127.0.0.1:15432). Avoids clashing with a local PostgreSQL on 5432.
POSTGIS_PORT=15432

# --- GeoServer ----------------------------------------------------------------
GEOSERVER_ADMIN_USER=admin
# GeoServer's default; fine on localhost, change it for anything shared.
GEOSERVER_ADMIN_PASSWORD=geoserver
GEOSERVER_PORT=8088
GEOSERVER_INITIAL_MEMORY=1G
GEOSERVER_MAXIMUM_MEMORY=2G
# Optional comma-separated kartoza plugin list, e.g. vectortiles-plugin
# (downloaded on first start; leave blank for the fastest startup).
GEOSERVER_STABLE_EXTENSIONS=

# --- pg_tileserv / pg_featureserv ----------------------------------------------
PG_TILESERV_PORT=7800
PG_FEATURESERV_PORT=9000

# --- API + MapLibre client -------------------------------------------
# Open http://localhost:8000 in the browser.
API_PORT=8000
# Nominatim's usage policy asks for an identifying User-Agent; add your email.
NOMINATIM_USER_AGENT=kochi-healthcare-webgis/1.0 (student project; contact: you@example.com)
